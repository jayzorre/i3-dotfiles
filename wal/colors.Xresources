! X colors.
! Generated by 'wal'
*foreground:        #ffffff
*background:        #000000
*.foreground:       #ffffff
*.background:       #000000
emacs*foreground:   #ffffff
emacs*background:   #000000
URxvt*foreground:   #ffffff
XTerm*foreground:   #ffffff
UXTerm*foreground:  #ffffff
URxvt*background:   [100]#000000
XTerm*background:   #000000
UXTerm*background:  #000000
URxvt*cursorColor:  #ff0000
XTerm*cursorColor:  #ff0000
UXTerm*cursorColor: #ff0000
URxvt*borderColor:  [100]#000000

! Colors 0-15.
*.color0: #000000
*color0:  #000000
*.color1: #ff0000
*color1:  #ff0000
*.color2: #ff0000
*color2:  #ff0000
*.color3: #ff0000
*color3:  #ff0000
*.color4: #ff0000
*color4:  #ff0000
*.color5: #ff0000
*color5:  #ff0000
*.color6: #ff0000
*color6:  #ff0000
*.color7: #ffffff
*color7:  #ffffff
*.color8: #000000
*color8:  #000000
*.color9: #ff0000
*color9:  #ff0000
*.color10: #ff0000
*color10:  #ff0000
*.color11: #ff0000
*color11:  #ff0000
*.color12: #ff0000
*color12:  #ff0000
*.color13: #ff0000
*color13:  #ff0000
*.color14: #ff0000
*color14:  #ff0000
*.color15: #ffffff
*color15:  #ffffff

! Black color that will not be affected by bold highlighting.
*.color66: #000000
*color66:  #000000

! Xclock colors.
XClock*foreground: #ffffff
XClock*background: #000000
XClock*majorColor:  rgba:ff/ff/ff/ff
XClock*minorColor:  rgba:ff/ff/ff/ff
XClock*hourColor:   rgba:ff/ff/ff/ff
XClock*minuteColor: rgba:ff/ff/ff/ff
XClock*secondColor: rgba:ff/ff/ff/ff

! Set depth to make transparency work.
URxvt*depth: 32
